generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Message {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  subject        String
  service        String?
  servicePackage String?
  serviceTier    String?
  budget         String?
  content        String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}
